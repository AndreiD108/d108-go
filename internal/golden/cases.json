{
  "about": "Conformance corpus for every logging library (standard.md). Each case is one call in a fixed context. A library passes when, for every case, its line parses to exactly the expected object, 'timestamp' is the first key, nothing is written when expected is null, and every check in 'checks' holds.",
  "context": {
    "service.name": "golden",
    "service.version": "1.0.0",
    "service.instance.id": "01JBX7Q2M9K4T8V6W3R5N1P0ZD",
    "now": "2026-10-27T14:03:11.482913Z",
    "min_level": "info",
    "process.pid": 4242
  },
  "order": "Only rule: timestamp is the first key. Other keys may come in any order.",
  "call_format": "level: debug|info|warn|error|fatal; msg; event: event name or null; attrs: ordered [key, value] pairs, a value that is an object means a group whose keys join with '.'; error: {type, message, stack} or null; span: {trace_id, span_id} or null; a value {\"repeat\": s, \"count\": n} means the string s repeated n times; run: a unit of work ended through the library (command.run or request.handled)",
  "cases": [
